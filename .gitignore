# Everything the installer recreates or the first run downloads.
# The repository is ~3 MB of code and examples; the rest weighs 36 GB.

.venv/
.uv/
modelos/
loras/*
!loras/.keep
salidas/*
!salidas/.keep
entradas/*
!entradas/.keep

# config.json describes THIS machine's hardware and ajustes.json holds local
# preferences: the installer and everyday use write them, not the repository.
config.json
config.json.bak
ajustes.json

# the zip is built by herramientas/empaquetar.py
QwenStudio.zip

__pycache__/
*.py[cod]
*.log
*.db
*.db-wal
*.db-shm
_meta_gen.json
.DS_Store
Thumbs.db

# cache for the PDF generator's fonts (it downloads them again if missing)
herramientas/.fuentes/
